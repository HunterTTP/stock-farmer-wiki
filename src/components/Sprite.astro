---
// One of the game's own pictures, from a table row's icon or a data path: <Sprite path="animals.chickens.icon" alt="A hen" />.
// Shown at a whole-number scale of its pixels that fits in `box` CSS pixels. Leave `alt` empty when the name is written beside it.
import { fact } from '../lib/tables.js';
import { spriteSize, spriteSrc } from '../lib/sprites.js';

interface Icon { src: string; width: number; height: number }
interface Props {
  icon?: Icon;
  path?: string;
  alt?: string;
  box?: number;
}
const { path, alt = '', box = 48 } = Astro.props;
const icon: Icon | undefined = Astro.props.icon ?? (path ? fact(path) : undefined);
const size = icon ? spriteSize(icon, box) : undefined;
---

{icon && size && (
  <img
    class="sprite"
    src={spriteSrc(icon, import.meta.env.BASE_URL)}
    alt={alt}
    width={Math.ceil(size.width)}
    height={Math.ceil(size.height)}
    style={`width:${size.width}px;height:${size.height}px`}
    loading="lazy"
    decoding="async"
  />
)}
