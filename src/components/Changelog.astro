---
// The game's own changelog, newest day first, as it was in the beta this site was published from. The publish step writes
// changelog.json (the days and their lines) and changelog-betas.json (the first beta each day's changes reached).
import { data } from '../lib/tables.js';

const days: { date: string; lines: string[] }[] = data.changelog ?? [];
const betas: Record<string, string> = data['changelog-betas'] ?? {};
const nice = (date: string) =>
  new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const betaName = (tag: string) => tag.replace(/^beta-/, 'Beta ');
---

{days.length === 0 && <p>The changelog appears here once the wiki is published with a beta.</p>}
{days.map((day) => (
  <section class="changelog-day">
    <h2 id={day.date}>{nice(day.date)}</h2>
    {betas[day.date] && <p class="changelog-beta">First in {betaName(betas[day.date])}</p>}
    <ul>{day.lines.map((line) => <li>{line}</li>)}</ul>
  </section>
))}
